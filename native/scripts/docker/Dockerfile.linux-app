# Build image for the SoftphonePro Linux desktop app (.deb + tarball), see app/linux/packaging/build_linux.sh.
# ubuntu:22.04 on purpose: glibc 2.35 is the baseline, so the result runs on Ubuntu 22.04/24.04,
# Debian 12/13 and Raspberry Pi OS Bookworm. Works for linux/amd64 and linux/arm64 (use --platform).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential clang pkg-config ninja-build perl curl ca-certificates git file unzip xz-utils zip \
      python3 python3-pip rsync patchelf \
      libgtk-3-dev liblzma-dev libstdc++-12-dev libasound2-dev libsecret-1-dev \
      libayatana-appindicator3-dev libnotify-dev libkeybinder-3.0-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev uuid-dev \
      dpkg-dev fakeroot lintian desktop-file-utils appstream imagemagick librsvg2-bin \
 && rm -rf /var/lib/apt/lists/*

# pjproject 2.17's CMake build needs CMake >= 3.28 (Ubuntu 22.04 ships 3.22).
RUN pip3 install --no-cache-dir 'cmake==3.31.*' && cmake --version

# Flutter pinned to the version the project is developed with.
ARG FLUTTER_VERSION=3.32.1
RUN git clone --depth 1 -b ${FLUTTER_VERSION} https://github.com/flutter/flutter.git /opt/flutter \
 && git config --global --add safe.directory '*' \
 && /opt/flutter/bin/flutter config --no-analytics --enable-linux-desktop \
 && /opt/flutter/bin/flutter precache --linux
ENV PATH=/opt/flutter/bin:$PATH \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    CI=true
WORKDIR /build
