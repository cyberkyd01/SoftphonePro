<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
		<string>de</string>
		<string>es</string>
		<string>fr</string>
		<string>hi</string>
		<string>it</string>
		<string>nl</string>
		<string>pt-BR</string>
		<string>ru</string>
		<string>tr</string>
		<string>ja</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>SoftphonePro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>softphonepro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>SoftphonePro needs the microphone to carry your voice during calls.</string>
	<key>NSContactsUsageDescription</key>
	<string>SoftphonePro can show your device contacts when you search or dial, and import them on request.</string>
	<key>NSCameraUsageDescription</key>
	<string>SoftphonePro uses the camera to scan provisioning and pairing QR codes.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>SoftphonePro uses Face ID to unlock the app.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SoftphonePro discovers other SoftphonePro devices on your local network.</string>
	<key>NSBonjourServices</key>
	<array><string>_softphonepro._tcp</string></array>
	<key>UIBackgroundModes</key>
	<array><string>audio</string><string>voip</string></array>
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.softphonepro.softphonepro</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sip</string>
				<string>sips</string>
				<string>tel</string>
				<string>callto</string>
				<string>softphonepro</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
	</array>
</dict>
</plist>
